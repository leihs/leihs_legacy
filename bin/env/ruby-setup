#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd -- "$(dirname "${BASH_SOURCE}")" ; cd ../.. > /dev/null 2>&1 && pwd -P)"
cd $PROJECT_DIR

source $PROJECT_DIR/bin/env/select-tool-versions-manager
source $PROJECT_DIR/bin/env/project.sh

case "$TOOL_VERSIONS_MANAGER" in
  asdf|asdf-vm)
    echo "Setting up ruby via asdf"
    ASDF_PLUGIN=ruby
    ASDF_PLUGIN_URL=https://github.com/asdf-vm/asdf-ruby.git
    source $PROJECT_DIR/bin/env/asdf-helper.bash
    asdf-update-plugin
    asdf install ruby
    ;;
  mise)
    echo "Setting up ruby via mise"
    mise install ruby
    ;;
  *)
    echo "ERROR: Unsupported TOOL_VERSIONS_MANAGER: $TOOL_VERSIONS_MANAGER"
    exit 1
    ;;
esac

# Install the bundler version the lockfile was written with explicitly (and
# under this script's exclusive CI resource) instead of letting bundler's
# self-manager auto-install it on first use, which raced on shared executors.
BUNDLER_VERSION="$(sed -n '/^BUNDLED WITH/{n;s/^[[:space:]]*//;p;}' Gemfile.lock)"
if [ -n "$BUNDLER_VERSION" ] && ! gem list -i bundler -v "$BUNDLER_VERSION" > /dev/null; then
  gem install bundler -v "$BUNDLER_VERSION" --no-document
fi

bundle install --quiet "$@"
