#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd -- "$(dirname "${BASH_SOURCE}")" ; cd .. > /dev/null 2>&1 && pwd -P)"
cd $PROJECT_DIR
./bin/env/firefox-setup
./bin/env/geckodriver-setup
./bin/env/nodejs-setup
./bin/env/ruby-setup

RAILS_ENV=test source ./database/bin/db-set-env

# clean-up the mess the ruby geckodriver gem might have created by placing it
# in ruby's bin dir (asdf or mise install), then refresh the shims
source ./bin/env/select-tool-versions-manager
rm -rf "$(ruby -e 'puts RbConfig::CONFIG["bindir"]')"/gecko*
case "$TOOL_VERSIONS_MANAGER" in
  mise) mise reshim ;;
  *)    asdf reshim ;;
esac

bundle exec cucumber "$@"
# vi: ft=sh
