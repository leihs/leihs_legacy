- grouped_lines.each_pair do |dates, reservations|

  .emboss.deep.padding-bottom-s.margin-bottom-m{:"data-selected-lines-container" => true}

    - if local_assigns[:show_courier_select_all]
      .grouped-lines-header.row
        .col1of2.padding-vertical-s
          %label.padding-inset-s.inline
            %input{:type => :checkbox, :"data-select-lines" => true, :autocomplete => :off}
          %p.paragraph-s.inline
            = l(dates[0], :format => "%A")
            = l(dates[0])
            \-
            = l(dates[1], :format => "%A")
            = l(dates[1])
        .col1of2.padding-inset-s.text-align-right
          %p.paragraph-s.inline
            = interval dates[0], dates[1]
        %label.font-normal{:"data-courier-select-all" => true}
          %input{:type => :checkbox, :"data-select-courier-lines" => true, :autocomplete => :off}
          = _("Select all")

      .row
        - if reservations.is_a? Array
          = render :partial => line_partial, :collection => reservations, :as => :line
        - else
          - reservations.each_pair do |model, reservations|
            = render :partial => line_partial, :locals => {:model => model, :reservations => reservations}

    - else
      .row
        .col1of2.padding-vertical-s
          %label.padding-inset-s.inline
            %input{:type => :checkbox, :"data-select-lines" => true, :autocomplete => :off}
          %p.paragraph-s.inline
            = l(dates[0], :format => "%A")
            = l(dates[0])
            \-
            = l(dates[1], :format => "%A")
            = l(dates[1])
        .col1of2.padding-inset-s.text-align-right
          %p.paragraph-s.inline
            = interval dates[0], dates[1]

      .row
        - if reservations.is_a? Array
          = render :partial => line_partial, :collection => reservations, :as => :line
        - else
          - reservations.each_pair do |model, reservations|
            = render :partial => line_partial, :locals => {:model => model, :reservations => reservations}
